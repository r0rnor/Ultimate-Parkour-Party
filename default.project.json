{
  "globIgnorePaths": [
    "**/package.json",
    "**/tsconfig.json"
  ],
  "name": "roblox-project",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "rbxts_include": {
        "$path": "include",
        "node_modules": {
          "$className": "Folder",
          "@rbxts": {
            "$path": "node_modules/@rbxts"
          }
        }
      },
      "shared": {
        "$className": "Folder",
        "features": {
          "$className": "Folder",
          "showcase": {
            "$className": "Folder",
            "showcase": {
              "$path": "out/features/showcase/shared/showcase.luau"
            }
          }
        }
      }
    },
    "ServerScriptService": {
      "server": {
        "$className": "Folder",
        "features": {
          "$className": "Folder",
          "showcase": {
            "$className": "Folder",
            "showcase": {
              "$path": "out/features/showcase/server/showcase.server.luau"
            }
          }
        }
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "client": {
          "$className": "Folder",
          "features": {
            "$className": "Folder",
            "showcase": {
              "$className": "Folder",
              "showcase": {
                "$path": "out/features/showcase/client/showcase.client.luau"
              }
            }
          }
        }
      }
    }
  }
}