{
  "globIgnorePaths": [
    "**/package.json",
    "**/tsconfig.json"
  ],
  "name": "roblox-project",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "rbxts_include": {
        "$path": "include",
        "node_modules": {
          "$className": "Folder",
          "@rbxts": {
            "$path": "node_modules/@rbxts"
          }
        }
      },
      "shared": {
        "$className": "Folder",
        "app": {
          "$className": "Folder",
          "ecs": {
            "$className": "Folder",
            "scheduler": {
              "$path": "out/app/ecs/shared/scheduler.luau"
            },
            "world": {
              "$path": "out/app/ecs/shared/world.luau"
            }
          }
        },
        "core": {
          "$className": "Folder",
          "components": {
            "$path": "out/core/components/shared"
          }
        },
        "features": {
          "$className": "Folder",
          "showcase": {
            "$className": "Folder",
            "showcase": {
              "$path": "out/features/showcase/shared/showcase.luau"
            }
          }
        },
        "infrastructure": {
          "$className": "Folder",
          "network": {
            "$className": "Folder",
            "network": {
              "$path": "out/infrastructure/network/shared/network.luau"
            }
          }
        }
      }
    },
    "ServerScriptService": {
      "server": {
        "$className": "Folder",
        "app": {
          "$className": "Folder",
          "bootstrap": {
            "$className": "Folder",
            "main": {
              "$path": "out/app/bootstrap/main.server.luau"
            }
          }
        },
        "features": {
          "$className": "Folder",
          "objects": {
            "$className": "Folder",
            "spikeSystems": {
              "$path": "out/features/objects/spikeSystems-server.luau"
            }
          },
          "player": {
            "$className": "Folder",
            "playerSystems": {
              "$path": "out/features/player/playerSystems-server.luau"
            }
          },
          "showcase": {
            "$className": "Folder",
            "showcase": {
              "$path": "out/features/showcase/server/showcase.server.luau"
            }
          }
        }
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "client": {
          "$className": "Folder",
          "app": {
            "$className": "Folder",
            "bootstrap": {
              "$className": "Folder",
              "main": {
                "$path": "out/app/bootstrap/main.client.luau"
              }
            }
          },
          "features": {
            "$className": "Folder",
            "showcase": {
              "$className": "Folder",
              "showcase": {
                "$path": "out/features/showcase/client/showcase.client.luau"
              }
            }
          }
        }
      }
    }
  }
}