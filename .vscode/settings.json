{
	"[typescript]": {
		"editor.defaultFormatter": "rvest.vs-code-prettier-eslint",
		"editor.formatOnSave": true,
		"editor.formatOnPaste": true,
		"editor.formatOnSaveMode": "file",
	},
	"[typescriptreact]": {
		"editor.defaultFormatter": "vscode.typescript-language-features",
		"editor.formatOnSave": true
	},
	"js/ts.tsdk.path": "node_modules/typescript/lib",
	"editor.autoClosingBrackets": "always",
	"files.exclude": {
		"flamework.build": true,
		"testez-companion.toml": true,
		"sourcemap.json": true,
		"include": true,
		"node_modules": false,
		".prettierrc": false,
		"cspell.config.yaml": false,
		"package-lock.json": true,
		"README.md": true,
		"tsconfig.json": false,
		".gitattributes": true,
		"test": true,
		"scripts": false,
		"out/**/*": true,
		".darklua.json": true,
		".env": true,
		"asphalt.lock.toml": true,
		".husky": true,
		".gitignore": false,
		".luaurc": true,
		"aftman.ci.toml": true,
		"flake.nix": true,
		"pnpm-workspace.yaml": false,
		"pnpm-lock.yaml": true,
		".envrc": false,
		"aftman.toml": false,
		".npmrc": false,
		"patches": true,
		"pesde.toml": true,
		"selene.toml": true,
		"roblox.yml": true,
		"lune_packages": true,
		"luau_packages": true,
		".pesde": true,
	},
	"files.watcherExclude": {
		"**/node_modules/**": true,
		"**/out/**": true,
		"**/objects/**": true,
		"**/.git/**": true,
		"OLD_OOP_SRC/**": true
	},
	"luau-lsp.sourcemap.rojoProjectFile": "default.project.json"
}
